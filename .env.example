# Your WhatsApp number with country code, digits only (no +, spaces, or dashes)
# Example for Bangladesh: 8801712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000

# Optional: Your Cloudinary Cloud Name (used if you pass Cloudinary public IDs instead of full URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Your live website URL (used for canonical URLs, sitemap.xml, robots.txt, and JSON-LD SEO)
NEXT_PUBLIC_SITE_URL=https://neoventisbiotech.com

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
